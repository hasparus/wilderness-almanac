{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "src/rendering/incremental-*.js",
    "src/rendering/retained-chunk-scene.js",
    "src/rendering/map-renderer.js",
    "src/rendering/map-controls.js",
    "src/ui/map-view.js",
    "src/rendering/chunk-transitions.js",
    "src/rendering/hex-reveal-geometry.js",
    "src/ui/view-navigation.js",
    "src/ui/campaign-loading-shell.js",
    "e2e/campaign-entry.spec.js",
    "src/rendering/map-picking.js",
    "src/generation/river-surfaces.js",
    "tests/river-surface-optimization.test.js",
    "src/ui/deferred-map-work.js",
    "tests/deferred-map-work.test.js",
    "tests/viewport-priority.test.js",
    "tests/river-surface-cache.test.js",
    "tests/deferred-river-rendering.test.js",
    "tests/chunk-transitions.test.js",
    "tests/incremental-builds.test.js",
    "e2e/incremental-renderer.spec.js",
    "e2e/deferred-previews.spec.js",
    "playwright.workspace.config.js"
  ]
}
